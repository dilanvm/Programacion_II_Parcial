<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.uniquindio.edu.co.parcial1.viewController.MatriculaViewController">
    <top>
        <VBox spacing="12">
            <padding>
                <Insets top="18" right="20" bottom="15" left="20"/>
            </padding>

            <Label text="Nueva matrícula"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <GridPane hgap="12" vgap="10">
                <Label text="Estudiante:"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="comboEstudiante"
                          promptText="Seleccionar estudiante"
                          prefWidth="220"
                          GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Curso:"
                       GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <ComboBox fx:id="comboCurso"
                          promptText="Seleccionar curso"
                          prefWidth="220"
                          GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <Label text="Fecha:"
                       GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <DatePicker fx:id="dpFecha"
                            prefWidth="220"
                            GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Descuento (%):"
                       GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <TextField fx:id="txtDescuento"
                           promptText="Ej. 10"
                           prefWidth="100"
                           GridPane.rowIndex="1" GridPane.columnIndex="3"/>
            </GridPane>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <VBox spacing="6">
                    <Label text="Servicios adicionales:"/>
                    <ListView fx:id="listaServicios"
                              prefWidth="280"
                              prefHeight="100"/>
                </VBox>

                <VBox fx:id="panelProfesor" spacing="6">
                    <Label text="Profesor (curso personalizado):"/>
                    <ComboBox fx:id="cbProfesor"
                              promptText="Seleccionar profesor"
                              prefWidth="220"/>
                </VBox>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button text="Registrar matrícula"
                        onAction="#onMatricular"
                        defaultButton="true"/>
                <Label text="Valor total:"/>
                <Label fx:id="lblValorEstimado"
                       text="0"
                       style="-fx-font-weight: bold"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Matrículas registradas"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <TableView fx:id="tablaMatriculas"
                       VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colEstudiante"
                                 text="Estudiante"
                                 prefWidth="160"/>
                    <TableColumn fx:id="colCurso"
                                 text="Curso"
                                 prefWidth="150"/>
                    <TableColumn fx:id="colFecha"
                                 text="Fecha"
                                 prefWidth="110"/>
                    <TableColumn fx:id="colServicios"
                                 text="Servicios"
                                 prefWidth="170"/>
                    <TableColumn fx:id="colDescuento"
                                 text="Descuento"
                                 prefWidth="100"/>
                    <TableColumn fx:id="colValorFinal"
                                 text="Valor final"
                                 prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>
