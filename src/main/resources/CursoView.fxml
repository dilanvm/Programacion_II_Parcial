<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.uniquindio.edu.co.parcial1.viewController.CursoViewController">

    <top>
        <VBox spacing="12">
            <padding>
                <Insets top="18" right="20" bottom="15" left="20"/>
            </padding>

            <Label text="Registro de cursos"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <GridPane hgap="12" vgap="10">
                <Label text="Tipo de curso:"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbTipoCurso"
                          promptText="Selecciona el tipo"
                          onAction="#onTipoCursoSeleccionado"
                          prefWidth="220"
                          GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Código:"
                       GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <TextField fx:id="txtCodigo"
                           promptText="Código del curso"
                           GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <Label text="Nombre:"
                       GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtNombre"
                           promptText="Nombre del curso"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Idioma:"
                       GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <ComboBox fx:id="cbIdioma"
                          promptText="Selecciona el idioma"
                          GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                <Label text="Duración (meses):"
                       GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txtDuracion"
                           promptText="Ej. 6"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Valor mensual:"
                       GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                <TextField fx:id="txtValorMensual"
                           promptText="Ej. 250000"
                           GridPane.rowIndex="2" GridPane.columnIndex="3"/>

                <Label text="Estado:"
                       GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbEstado"
                          promptText="Selecciona el estado"
                          GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Descuento (%):"
                       GridPane.rowIndex="3" GridPane.columnIndex="2"/>
                <TextField fx:id="txtDescuento"
                           promptText="Ej. 10"
                           GridPane.rowIndex="3" GridPane.columnIndex="3"/>
            </GridPane>

            <Label text="Descripción:"/>
            <TextArea fx:id="txtDescripcion"
                      promptText="Describe el curso"
                      prefRowCount="2"
                      wrapText="true"/>

            <VBox fx:id="panelRegular" spacing="6"
                  visible="false" managed="false">
                <Label text="Beneficios del curso regular:"/>
                <CheckBox fx:id="checkAccesoPlataforma"
                          text="Incluye acceso a la plataforma"/>
                <CheckBox fx:id="checkMaterialDidactico"
                          text="Incluye material didáctico"/>
            </VBox>

            <VBox fx:id="panelIntensivo" spacing="6"
                  visible="false" managed="false">
                <Label text="Beneficios del curso intensivo:"/>
                <CheckBox fx:id="checkClubConversacion"
                          text="Incluye club de conversación"/>
            </VBox>

            <GridPane fx:id="panelPersonalizado"
                      hgap="12" vgap="8"
                      visible="false" managed="false">
                <Label text="Sesiones con profesor:"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtSesiones"
                           promptText="Ej. 12"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Nivel de referencia:"
                       GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbNivelReferencia"
                          promptText="Selecciona el nivel"
                          GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Objetivos del estudiante:"
                       GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextArea fx:id="txtObjetivo"
                          promptText="Describe los objetivos"
                          prefRowCount="2"
                          wrapText="true"
                          GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="10">
                <Button text="Registrar curso"
                        onAction="#onRegistrarCurso"
                        defaultButton="true"/>
                <Button text="Limpiar"
                        onAction="#onLimpiar"/>
            </HBox>

            <Label fx:id="lblMensaje"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Cursos registrados"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <TableView fx:id="tablaCursos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCodigo"
                                 text="Código"
                                 prefWidth="90"/>
                    <TableColumn fx:id="colNombre"
                                 text="Nombre"
                                 prefWidth="180"/>
                    <TableColumn fx:id="colIdioma"
                                 text="Idioma"
                                 prefWidth="110"/>
                    <TableColumn fx:id="colTipo"
                                 text="Tipo"
                                 prefWidth="130"/>
                    <TableColumn fx:id="colDuracion"
                                 text="Duración"
                                 prefWidth="100"/>
                    <TableColumn fx:id="colValor"
                                 text="Valor mensual"
                                 prefWidth="120"/>
                    <TableColumn fx:id="colEstado"
                                 text="Estado"
                                 prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>